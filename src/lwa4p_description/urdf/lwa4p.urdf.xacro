<?xml version="1.0"?>
<!-- Schunk LWA 4P. Kinematics/limits from ipa320/schunk_modular_robotics
     (schunk_description/urdf/lwa4p). Joint i = CANopen node i+2. -->
<robot name="lwa4p" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh" value="package://lwa4p_description/meshes/lwa4p"/>
  <!-- limits from the SCHUNK datasheets: range = preset software limit switches
       (LWA 4P manual 3.2: +-170 deg, axis 3 +-155 deg) minus 4 deg - must stay
       inside the driver's limit_margin_deg (3 deg) or MoveIt plans goals the
       driver then refuses ("outside drive limits"),
       72 deg/s, effort = max. torque (ERB 145: 64 Nm, ERB 115: 19 Nm) -->
  <xacro:property name="safety_offset" value="${radians(4)}"/>
  <xacro:property name="lim" value="${radians(170) - safety_offset}"/>
  <xacro:property name="lim3" value="${radians(155) - safety_offset}"/>
  <xacro:property name="vel" value="${radians(72)}"/>

  <material name="schunk_blue"><color rgba="0.0 0.25 0.6 1.0"/></material>
  <material name="schunk_grey"><color rgba="0.75 0.75 0.75 1.0"/></material>

  <xacro:macro name="arm_link" params="name stl material">
    <link name="${name}">
      <visual>
        <geometry><mesh filename="${mesh}/${stl}.stl"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh}/${stl}.stl"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="arm_joint" params="n parent child xyz rpy effort lower upper">
    <joint name="arm_${n}_joint" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${effort}" velocity="${vel}" lower="${lower}" upper="${upper}"/>
    </joint>
  </xacro:macro>

  <link name="world"/>

  <!-- pedestal (the base with the LWA / AUX connectors) -->
  <joint name="arm_podest_joint" type="fixed">
    <parent link="world"/>
    <child link="arm_podest_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- measured with the calibrated wrist camera (2026-11-07): the real base
       column is r ~0.10 m from the mounting surface (z -0.110) up to z 0.017;
       the ipa320 mesh is only 5 cm tall, so a cylinder of the real size -->
  <link name="arm_podest_link">
    <visual>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <geometry><cylinder radius="0.103" length="0.127"/></geometry>
      <material name="schunk_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <geometry><cylinder radius="0.105" length="0.127"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="arm_podest_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>
  <!-- tiny inertial: Gazebo drops a massless link together with the whole arm below it -->
  <link name="arm_base_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <xacro:arm_joint n="1" parent="arm_base_link" child="arm_1_link"
                   xyz="0 0 0" rpy="0 0 0" effort="64" lower="${-lim}" upper="${lim}"/>
  <xacro:arm_link name="arm_1_link" stl="arm_1_link" material="schunk_blue"/>

  <xacro:arm_joint n="2" parent="arm_1_link" child="arm_2_link"
                   xyz="0 0 0" rpy="1.5708 0 0" effort="64" lower="${-lim}" upper="${lim}"/>
  <xacro:arm_link name="arm_2_link" stl="arm_2_link" material="schunk_grey"/>

  <xacro:arm_joint n="3" parent="arm_2_link" child="arm_3_link"
                   xyz="0 0.350 0" rpy="0 3.14159 0" effort="64" lower="${-lim3}" upper="${lim3}"/>
  <xacro:arm_link name="arm_3_link" stl="arm_3_link" material="schunk_blue"/>

  <xacro:arm_joint n="4" parent="arm_3_link" child="arm_4_link"
                   xyz="0 0 0" rpy="-1.5708 3.14159 0" effort="64" lower="${-lim}" upper="${lim}"/>
  <xacro:arm_link name="arm_4_link" stl="arm_4_link" material="schunk_grey"/>

  <xacro:arm_joint n="5" parent="arm_4_link" child="arm_5_link"
                   xyz="0 0.005263 0.305" rpy="1.5708 0 3.14159" effort="19" lower="${-lim}" upper="${lim}"/>
  <xacro:arm_link name="arm_5_link" stl="arm_5_link" material="schunk_blue"/>

  <xacro:arm_joint n="6" parent="arm_5_link" child="arm_6_link"
                   xyz="0 0 0" rpy="-1.5708 0 0" effort="19" lower="${-lim}" upper="${lim}"/>
  <xacro:arm_link name="arm_6_link" stl="arm_6_link" material="schunk_grey"/>

  <!-- tool flange face (end of the arm_6 mesh, z = 0.084) -->
  <joint name="arm_tool0_joint" type="fixed">
    <parent link="arm_6_link"/>
    <child link="arm_tool0"/>
    <origin xyz="0 0 0.084" rpy="0 0 0"/>
  </joint>
  <link name="arm_tool0"/>

  <!-- Hand-eye calibrated RealSense D435 on the flange. Only camera_link is
       attached here; realsense2_camera publishes camera_link -> color/depth
       optical frames from the factory extrinsics. config/camera_calibration.yaml
       holds the hand-eye calibration result (arm_tool0 -> camera_link). -->
  <xacro:arg name="wrist_camera" default="true"/>
  <xacro:if value="$(arg wrist_camera)">
    <xacro:property name="cam" value="${xacro.load_yaml('$(find lwa4p_description)/config/camera_calibration.yaml')['camera_link']}"/>
    <joint name="camera_mount_joint" type="fixed">
      <parent link="arm_tool0"/>
      <child link="camera_link"/>
      <origin xyz="${' '.join(str(v) for v in cam['xyz'])}" rpy="${' '.join(str(v) for v in cam['rpy'])}"/>
    </joint>
    <!-- D435 (90 x 25 x 25 mm) plus bracket, screws and cable plug; camera_link
         x = optical axis, y = along the body. Generous because the extrinsic is
         only good to ~1 cm and the bracket screw once jammed against arm_4. -->
    <link name="camera_link">
      <!-- visual = the collision box, so RViz shows what MoveIt keeps clear -->
      <visual>
        <origin xyz="-0.02 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.13 0.05"/></geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.02 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.13 0.05"/></geometry>
      </collision>
    </link>
  </xacro:if>

  <!-- SCHUNK FTM 75 force-torque sensor between the flange and the gripper:
       adds 52.75 mm, the gripper then sits on ftm_tool0 -->
  <xacro:arg name="ftm" default="true"/>
  <xacro:if value="$(arg ftm)">
    <xacro:include filename="$(find lwa4p_description)/urdf/ftm75.urdf.xacro"/>
    <xacro:ftm75 parent="arm_tool0"/>
  </xacro:if>

  <xacro:arg name="gripper" default="true"/>
  <!-- rotate the gripper about the flange axis if RViz doesn't match the real arm -->
  <xacro:arg name="gripper_yaw" default="1.5708"/>
  <xacro:if value="$(arg gripper)">
    <xacro:include filename="$(find lwa4p_description)/urdf/wsg50.urdf.xacro"/>
    <xacro:wsg50 parent="${'ftm_tool0' if '$(arg ftm)' == 'true' else 'arm_tool0'}" yaw="$(arg gripper_yaw)"/>
  </xacro:if>

  <!-- fixed obstacles around the real robot (table, frame, dispenser, racks, ...).
       Part of the robot description, so RViz shows them and MoveIt plans around
       them. The Gazebo sim has its own world and switches them off. -->
  <xacro:arg name="workspace_obstacles" default="true"/>
  <xacro:if value="$(arg workspace_obstacles)">
    <xacro:include filename="$(find lwa4p_description)/urdf/workspace_obstacles.urdf.xacro"/>
  </xacro:if>
</robot>
