<?xml version="1.0"?>
<!-- Weiss/Schunk WSG 50-110 on the FWA115 adapter, simple box geometry.
     Dimensions are approximate (measure and adjust): adapter 20 mm,
     housing 146 x 52 x 72 mm, fingers 20 x 30 x 90 mm.

     gripper_joint = fingertip GAP in metres (same number the gripper node,
     MoveIt and `arm_cmd.sh grip` use). Each finger mimics half of it.
     Inertials are rough guesses (WSG 50 ~1.2 kg), only Gazebo uses them. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wsg50" params="parent yaw:=0">
    <xacro:property name="adapter_h" value="0.020"/>
    <xacro:property name="body_x" value="0.146"/>
    <xacro:property name="body_y" value="0.052"/>
    <xacro:property name="body_h" value="0.072"/>
    <xacro:property name="finger_t" value="0.020"/>
    <xacro:property name="finger_w" value="0.030"/>
    <xacro:property name="finger_l" value="0.090"/>
    <xacro:property name="gap_max" value="0.0895"/>

    <material name="wsg_grey"><color rgba="0.6 0.6 0.62 1.0"/></material>
    <material name="wsg_black"><color rgba="0.1 0.1 0.1 1.0"/></material>

    <joint name="gripper_adapter_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_adapter_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
    </joint>
    <link name="gripper_adapter_link">
      <visual>
        <origin xyz="0 0 ${adapter_h / 2}"/>
        <geometry><cylinder radius="0.042" length="${adapter_h}"/></geometry>
        <material name="wsg_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${adapter_h / 2}"/>
        <geometry><cylinder radius="0.042" length="${adapter_h}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>

    <joint name="gripper_body_joint" type="fixed">
      <parent link="gripper_adapter_link"/>
      <child link="gripper_body_link"/>
      <origin xyz="0 0 ${adapter_h}" rpy="0 0 0"/>
    </joint>
    <link name="gripper_body_link">
      <visual>
        <origin xyz="0 0 ${body_h / 2}"/>
        <geometry><box size="${body_x} ${body_y} ${body_h}"/></geometry>
        <material name="wsg_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${body_h / 2}"/>
        <geometry><box size="${body_x} ${body_y} ${body_h}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.2"/>
        <inertia ixx="3e-3" ixy="0" ixz="0" iyy="3e-3" iyz="0" izz="3e-3"/>
      </inertial>
    </link>

    <!-- the commanded joint: fingertip gap. Its link carries no geometry
         (tiny inertial only so that Gazebo keeps the joint). -->
    <joint name="gripper_joint" type="prismatic">
      <parent link="gripper_body_link"/>
      <child link="gripper_gap_link"/>
      <origin xyz="0 0 ${body_h}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="${gap_max}" effort="80" velocity="0.42"/>
    </joint>
    <link name="gripper_gap_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <xacro:macro name="finger" params="side sign">
      <joint name="gripper_finger_${side}_joint" type="prismatic">
        <parent link="gripper_body_link"/>
        <child link="gripper_finger_${side}_link"/>
        <origin xyz="0 0 ${body_h}" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-gap_max}" upper="${gap_max}" effort="80" velocity="0.42"/>
        <mimic joint="gripper_joint" multiplier="${sign * 0.5}" offset="0"/>
      </joint>
      <!-- link origin = inner (gripping) face of the finger -->
      <link name="gripper_finger_${side}_link">
        <visual>
          <origin xyz="${sign * finger_t / 2} 0 ${finger_l / 2}"/>
          <geometry><box size="${finger_t} ${finger_w} ${finger_l}"/></geometry>
          <material name="wsg_black"/>
        </visual>
        <collision>
          <origin xyz="${sign * finger_t / 2} 0 ${finger_l / 2}"/>
          <geometry><box size="${finger_t} ${finger_w} ${finger_l}"/></geometry>
        </collision>
        <inertial>
          <origin xyz="${sign * finger_t / 2} 0 ${finger_l / 2}"/>
          <mass value="0.05"/>
          <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="5e-6"/>
        </inertial>
      </link>
    </xacro:macro>
    <xacro:finger side="left" sign="-1"/>
    <xacro:finger side="right" sign="1"/>

    <!-- tool centre point: between the fingertips, 15 mm up from the tip -->
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="gripper_body_link"/>
      <child link="gripper_tcp"/>
      <origin xyz="0 0 ${body_h + finger_l - 0.015}" rpy="0 0 0"/>
    </joint>
    <link name="gripper_tcp"/>
  </xacro:macro>
</robot>
