<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lwa4p_table">
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- floor 6 cm below the robot origin: the pedestal mesh reaches 5 cm
         below z=0 and must not touch the floor (that throws the arm around) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><iters>100</iters></solver></ode>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <gui>
      <camera name="user_camera">
        <pose>1.6 -1.2 0.9 0 0.3 2.5</pose>
      </camera>
    </gui>

    <model name="stand">
      <static>true</static>
      <!-- top at z = 0.10, standing on the floor at z = -0.06 -->
      <pose>0.5 0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.4 0.16</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 0.4 0.16</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="test_tube">
      <pose>0.45 0 0.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>1.4e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.0075</radius><length>0.1</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.0</min_depth><max_vel>0</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.0075</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.9 0.9 1.0 1</ambient><diffuse>0.8 0.85 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_cube">
      <pose>0.45 0.12 0.115 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>7.5e-6</ixx><iyy>7.5e-6</iyy><izz>7.5e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.0</min_depth><max_vel>0</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- bin for bin picking: outer 30 x 24 x 10 cm, inside floor at z = -0.05 -->
    <model name="bin">
      <static>true</static>
      <pose>0.24 -0.33 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="bottom_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.3 0.24 0.01</size></box></geometry></collision>
        <visual name="bottom_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.3 0.24 0.01</size></box></geometry>
          <material><ambient>0.15 0.35 0.15 1</ambient><diffuse>0.2 0.45 0.2 1</diffuse></material></visual>
        <collision name="wall_xn_c"><pose>-0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry></collision>
        <visual name="wall_xn_v"><pose>-0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry>
          <material><ambient>0.15 0.35 0.15 1</ambient><diffuse>0.2 0.45 0.2 1</diffuse></material></visual>
        <collision name="wall_xp_c"><pose>0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry></collision>
        <visual name="wall_xp_v"><pose>0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry>
          <material><ambient>0.15 0.35 0.15 1</ambient><diffuse>0.2 0.45 0.2 1</diffuse></material></visual>
        <collision name="wall_yn_c"><pose>0 -0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry></collision>
        <visual name="wall_yn_v"><pose>0 -0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry>
          <material><ambient>0.15 0.35 0.15 1</ambient><diffuse>0.2 0.45 0.2 1</diffuse></material></visual>
        <collision name="wall_yp_c"><pose>0 0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry></collision>
        <visual name="wall_yp_v"><pose>0 0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry>
          <material><ambient>0.15 0.35 0.15 1</ambient><diffuse>0.2 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <!-- output bin (same size) on the other side -->
    <model name="out_bin">
      <static>true</static>
      <pose>0.24 0.33 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="bottom_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.3 0.24 0.01</size></box></geometry></collision>
        <visual name="bottom_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.3 0.24 0.01</size></box></geometry>
          <material><ambient>0.15 0.15 0.4 1</ambient><diffuse>0.2 0.2 0.55 1</diffuse></material></visual>
        <collision name="wall_xn_c"><pose>-0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry></collision>
        <visual name="wall_xn_v"><pose>-0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.4 1</ambient><diffuse>0.2 0.2 0.55 1</diffuse></material></visual>
        <collision name="wall_xp_c"><pose>0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry></collision>
        <visual name="wall_xp_v"><pose>0.145 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.24 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.4 1</ambient><diffuse>0.2 0.2 0.55 1</diffuse></material></visual>
        <collision name="wall_yn_c"><pose>0 -0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry></collision>
        <visual name="wall_yn_v"><pose>0 -0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.4 1</ambient><diffuse>0.2 0.2 0.55 1</diffuse></material></visual>
        <collision name="wall_yp_c"><pose>0 0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry></collision>
        <visual name="wall_yp_v"><pose>0 0.115 0.05 0 0 0</pose><geometry><box><size>0.28 0.01 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.4 1</ambient><diffuse>0.2 0.2 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_box">
      <pose>0.18 -0.28 -0.03 0 0 0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-05</ixx><iyy>1.33e-05</iyy><izz>1.33e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.0</min_depth><max_vel>0</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="green_box">
      <pose>0.3 -0.39 -0.025 0 0 -0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.55e-05</ixx><iyy>1.55e-05</iyy><izz>1.02e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.035 0.035 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.0</min_depth><max_vel>0</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.035 0.035 0.05</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="blue_cylinder">
      <pose>0.29 -0.27 -0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.45e-05</ixx><iyy>1.45e-05</iyy><izz>8.1e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.018</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.0</min_depth><max_vel>0</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.018</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.85 1</ambient><diffuse>0.1 0.2 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="yellow_box">
      <pose>0.18 -0.39 -0.035 0 0 0.5</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>7.5e-06</ixx><iyy>1.42e-05</iyy><izz>1.42e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.05 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.0</min_depth><max_vel>0</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 0.03 0.03</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
