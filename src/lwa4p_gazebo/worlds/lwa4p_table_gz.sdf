<?xml version="1.0"?>
<!-- Gazebo Harmonic version of lwa4p_table.world (same models and poses).
     Movable objects carry a PosePublisher (named poses for sim_world.py).
     Generated from lwa4p_table.world: edit that one and regenerate, or keep both in sync. -->
<sdf version="1.9">
  <world name="lwa4p_table">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
