<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lwa4p">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <xacro:include filename="$(find lwa4p_description)/urdf/lwa4p.urdf.xacro" />

    <xacro:include filename="lwa4p.ros2_control.xacro" />


    <xacro:lwa4p_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
