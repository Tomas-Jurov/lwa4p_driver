  <version>0.1.0</version>
  <description>CANopen (SocketCAN) driver for the Schunk LWA 4P: joint_states + FollowJointTrajectory</description>
  <maintainer email="tomas.jurov@stuba.sk">tomas</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
